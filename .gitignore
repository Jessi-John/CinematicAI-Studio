# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Fix: Exclude Playwright test artifacts (trace files, screenshots, test results).
# test-results/ was previously committed to the repo, adding ~15MB of local
# run artifacts. This directory is auto-generated by Playwright.
/test-results/
playwright-report/
playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Output/log files at root (docker compose output, script logs)
/*.out

# ZAP scan results (rules.tsv in .zap/ is tracked for CI)
.zap/results/
.zap/reports/

# Windows / shell artifacts that occasionally appear at the repository root
/nul
/OF
/PY
/story.json

# Husky v9 auto-generated hook templates (regenerated by prepare script)
backend/.husky/_/

# L5 — Log files (backend server logs, test logs, etc.)
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Fix #1: .env.example IS the source of truth for required keys. Every other
# .env* file is local-only. The pre-commit hook in .husky/pre-commit enforces
# this at commit time even if a future .gitignore edit accidentally re-adds
# .env. If you need to re-introduce a tracked env file, add a per-file
# exception with `!` and a comment explaining why.
.env*
!.env.example

# Backup / scratch files
.env.backup
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
tsconfig.test.tsbuildinfo
next-env.d.ts

# gitleaks — local baseline
.gitleaks.baseline

# backend
backend/dist/
backend/node_modules/
backend/.env

# claude settings — contains local secrets, commands with API keys
.claude/

# standalone build artifact — may contain .env with secrets
.next/standalone/.env

# Docker secrets directory (contains generated credentials)
/secrets/


# Ad-hoc audit tooling outputs (JWT/CSRF-bearing) — never commit
genre-audit*-results.json
test-artifacts/
