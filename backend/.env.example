# CinematicAI Studio Backend - Environment Configuration
# Copy to .env and fill in values. Never commit .env.
#
# This template is for running the backend directly on the host
# (`npm run dev` or `npm run worker`). The Docker stack receives sensitive
# values from files in secrets/ instead of this file.

# ---- AI providers (at least one required for real generation) ----
# Kimi K3 (fallback) - OpenAI-compatible endpoint.
# KIMI_API_KEY="your-kimi-key-here"
# KIMI_BASE_URL="https://api.kimi.com/coding/v1/chat/completions"
# KIMI_MODEL="k3"

# Mistral AI (primary provider + embeddings).
# Get your API key from https://console.mistral.ai
# MISTRAL_API_KEY="your-mistral-api-key-here"
# MISTRAL_BASE_URL="https://api.mistral.ai/v1"
# MISTRAL_MODEL="mistral-medium-2508"
# EMBEDDING_MODEL="mistral-embed-2312"

# ---- Database ----
# Host-run backend: use the Compose host port (15432) when host port
# forwarding is available. Replace the password with the value in
# secrets/postgres_password. On Docker Desktop for Windows/macOS the internal
# data services are not reachable from the host; use the full Docker stack or
# a native PostgreSQL instance instead.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_SECRETS_POSTGRES_PASSWORD@localhost:15432/cinematicai?schema=public"

# ---- Redis (BullMQ + pub/sub + rate limit + token budget) ----
# SEC-002: Redis password is REQUIRED. Without it, Redis accepts unauthenticated
# connections. Generate a strong random password with: openssl rand -hex 32
# When using the Compose Redis, this must match secrets/redis_password.
REDIS_URL=redis://:REPLACE_WITH_SECRETS_REDIS_PASSWORD@localhost:6379
# Optional fallback for clients that read REDIS_PASSWORD separately. When set
# alongside REDIS_URL, the URL-embedded password takes precedence.
# REDIS_PASSWORD="REPLACE_WITH_SECRETS_REDIS_PASSWORD"

# ---- Server ----
PORT=34567
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# ---- Authentication secrets ----
# API_SECRET signs SSE URLs. In development an ephemeral random value is
# generated when this is unset; in production it is required.
# API_SECRET=""

# ADMIN_API_KEY enables Bearer-token access to admin-only routes. In
# development an ephemeral random value is generated when this is unset; in
# production it is required. Admin JWT sessions work without it.
# ADMIN_API_KEY=""

# JWT_SECRET signs session cookies. Generate one 64-hex value and use the SAME
# value in the frontend .env.local; otherwise the frontend proxy cannot verify
# backend-issued sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=""

# ---- Worker ----
# When true, the API process also runs the BullMQ worker in-process.
# In production (NODE_ENV=production), defaults to false if unset.
RUN_WORKER_INPROCESS=true

# Number of concurrent story generation jobs (default: 2).
# Raise this on multi-core machines with sufficient Redis/DB connections.
WORKER_CONCURRENCY=2

# BullMQ rate limiter: max jobs per window (default: 10 per 60s).
WORKER_RATE_LIMIT_MAX=10
WORKER_RATE_LIMIT_WINDOW_MS=60000

# AI rate limit: max requests per minute per IP to /api/stories/generate (default: 30)
AI_RATE_LIMIT_MAX=30

# ---- Auth Rate Limits ----
# Max login attempts per 15-minute window per IP (default: 10).
# Raise for integration testing. Set E2E_TEST=true to disable all auth rate limits.
AUTH_LOGIN_RATE_LIMIT_MAX=10
# Max registration attempts per 15-minute window per IP (default: 10).
AUTH_REGISTER_RATE_LIMIT_MAX=10
# Max session operations (GET /me, POST /refresh, /logout) per 15-minute window (default: 30).
AUTH_SESSION_RATE_LIMIT_MAX=30

# ---- Frontend (configured separately) ----
# The backend does not consume frontend variables. For `npm run dev`, set
# API_BASE_URL and JWT_SECRET in the repository-root .env.local. The Docker
# frontend receives API_BASE_URL from Compose and JWT_SECRET from
# /run/secrets/jwt_secret.

# ---- OpenTelemetry Tracing ----
# OTLP collector endpoint (e.g., Jaeger, Tempo, Honeycomb).
# In production with the Compose Jaeger service:
#   http://jaeger:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=cinematicai-backend

# ---- Metrics ACL ----
# The /metrics endpoint allows loopback and RFC1918/Docker networks by default.
# Set a narrower comma-separated CIDR list in production if your scraper has a
# fixed address.
# METRICS_ALLOWED_CIDRS=10.0.0.0/8

# ---- Insecure local HTTP ----
# Only needed when NODE_ENV=production without TLS (for example, the local
# Docker Compose stack, which sets it automatically). A host-run backend with
# NODE_ENV=development does not need it. NEVER enable in production.
# ALLOW_INSECURE_LOCAL_HTTP=false

# ---- Production Hardening ----
# Set DISABLE_REGISTRATION=true to block open signup.
# The first user can still register with INVITE_CODE; subsequent registrations are rejected.
#
# HIGH-6: When DISABLE_REGISTRATION=false (open registration), the first user
# is a regular user by default - auto-elevation to admin requires
# BOOTSTRAP_FIRST_USER_ADMIN=true. This prevents an attacker from owning the
# deployment by registering first on a fresh public instance. When
# DISABLE_REGISTRATION=true (invite-only), the first user is always admin
# because they passed the INVITE_CODE gate.
# DISABLE_REGISTRATION=false
# INVITE_CODE=change_me_to_a_random_32_char_string
# BOOTSTRAP_FIRST_USER_ADMIN=false

# AI cost and quota controls. 0 = unlimited.
# MAX_CONCURRENT_GENERATIONS=2
# MAX_STORIES_PER_DAY=10
# AI_DAILY_SPEND_CAP_USD=10
# AI_MONTHLY_SPEND_CAP_USD=100
# AI_DAILY_TOKEN_BUDGET=100000
# AI_MONTHLY_TOKEN_BUDGET=1000000

# Alert receiver token for Prometheus/Alertmanager webhooks.
# Generate with: openssl rand -hex 32
# ALERT_RECEIVER_TOKEN=change_me_to_a_random_64_char_hex_string

# Optional external webhook for Prometheus alerts.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
