# CinematicAI Studio Backend - Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# ---- Kimi K2.6 thinking (story blueprints, bibles, episodes, scenes, dialogue, SEO) ----
# OpenAI-compatible endpoint. Primary provider for all story generation.
# KIMI_API_KEY="sk-your-kimi-key-here"
# KIMI_BASE_URL="https://api.kimi.com/coding/v1/chat/completions"
# KIMI_MODEL="kimi-k2-6-thinking"

# ---- Mistral AI (fallback provider + embeddings) ----
# Fallback for both Kimi stages. Also used for embeddings.
# Uses OpenAI-compatible API. Get your API key from https://console.mistral.ai
# MISTRAL_API_KEY="your-mistral-api-key-here"
# MISTRAL_BASE_URL="https://api.mistral.ai/v1"
# MISTRAL_MODEL="mistral-medium-2508"

# ---- Database ----
DATABASE_URL="postgresql://postgres:password@localhost:5432/cinematicai?schema=public"

# ---- Redis (BullMQ + pub/sub + rate limit + token budget) ----
# SEC-002: Redis password is REQUIRED. Without it, Redis accepts unauthenticated
# connections. Generate a strong random password with: openssl rand -hex 32
# The password must match the REDIS_PASSWORD in docker-compose.yml for production.
REDIS_URL=redis://:your-redis-password-here@localhost:6379
REDIS_PASSWORD="your-redis-password-here"

# ---- Server ----
PORT=34567
NODE_ENV=development
LOG_LEVEL=info

# ALLOW_INSECURE_LOCAL_HTTP=true opts the backend into accepting cookie/CSRF/JWT
# auth over plain HTTP. Required when running the backend directly on localhost
# without TLS, because browsers withhold Secure cookies over HTTP and the
# backend rejects non-TLS auth by default. NEVER enable in production.
# ALLOW_INSECURE_LOCAL_HTTP=false

# ---- OpenTelemetry Tracing ----
# OTLP collector endpoint (e.g., Jaeger, Tempo, Honeycomb)
# In production with Jaeger: http://jaeger:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=winston-ai-backend

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- API Authentication ----
# Required in production (NODE_ENV=production). Must be a strong random string.
# In development/test mode, a dev fallback secret is used automatically.
API_SECRET="local_dev_secret_not_for_production_replace_me"

# ---- Worker ----
# When true, the API process also runs the BullMQ worker in-process.
# In production (NODE_ENV=production), defaults to false if unset.
RUN_WORKER_INPROCESS=true

# Number of concurrent story generation jobs (default: 2).
# Raise this on multi-core machines with sufficient Redis/DB connections.
WORKER_CONCURRENCY=2

# BullMQ rate limiter: max jobs per window (default: 10 per 60s).
WORKER_RATE_LIMIT_MAX=10
WORKER_RATE_LIMIT_WINDOW_MS=60000

# AI rate limit: max requests per minute per IP to /api/stories/generate (default: 30)
AI_RATE_LIMIT_MAX=30

# ---- Auth Rate Limits ----
# Max login attempts per 15-minute window per IP (default: 10).
# Raise for integration testing. Set E2E_TEST=true to disable all auth rate limits.
AUTH_LOGIN_RATE_LIMIT_MAX=10
# Max registration attempts per 15-minute window per IP (default: 10).
AUTH_REGISTER_RATE_LIMIT_MAX=10
# Max session operations (GET /me, POST /refresh, /logout) per 15-minute window (default: 30).
AUTH_SESSION_RATE_LIMIT_MAX=30

# ---- Frontend API Base ----
# Required by the Next.js frontend. Set to the backend URL accessible to browser clients.
# In development: http://localhost:34567
# In production: https://your-backend-domain.com
NEXT_PUBLIC_API_URL=http://localhost:34567

# ---- Production Hardening ----
# SINGLE_USER_MODE: set DISABLE_REGISTRATION=true to block open signup.
# The first user can still register with INVITE_CODE; subsequent registrations are rejected.
#
# HIGH-6: When DISABLE_REGISTRATION=false (open registration), the first user
# is a regular user by default — auto-elevation to admin requires
# BOOTSTRAP_FIRST_USER_ADMIN=true. This prevents an attacker from owning the
# deployment by registering first on a fresh public instance. When
# DISABLE_REGISTRATION=true (invite-only), the first user is always admin
# because they passed the INVITE_CODE gate.
# DISABLE_REGISTRATION=false
# INVITE_CODE=change_me_to_a_random_32_char_string
# BOOTSTRAP_FIRST_USER_ADMIN=false

# AI cost and quota controls. 0 = unlimited.
# MAX_CONCURRENT_GENERATIONS=2
# MAX_STORIES_PER_DAY=10
# AI_DAILY_SPEND_CAP_USD=10
# AI_MONTHLY_SPEND_CAP_USD=100
# AI_DAILY_TOKEN_BUDGET=100000
# AI_MONTHLY_TOKEN_BUDGET=1000000

# Alert receiver token for Prometheus/Alertmanager webhooks.
# Generate with: openssl rand -hex 32
# ALERT_RECEIVER_TOKEN=change_me_to_a_random_64_char_hex_string

# Optional external webhook for Prometheus alerts.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Local dev HTTP opt-in. NEVER enable in production.
# ALLOW_INSECURE_LOCAL_HTTP=false
