{
  "name": "cinematicai-backend",
  "version": "1.0.1",
  "license": "MIT",
  "private": true,
  "description": "Backend API for CinematicAI Studio - original storybook anime AI story generation",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/queue/workers/run-worker.ts",
    "queue:flush": "tsx src/queue/flush-queues.ts",
    "cleanup:test-users": "tsx src/scripts/cleanup-test-users.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "cross-env RUN_SCHEMA_SYNC=1 vitest run src/database/schema-audit.test.ts",
    "test:schema": "cross-env RUN_SCHEMA_SYNC=1 vitest run src/database/schema-audit.test.ts",
    "test:hnsw": "cross-env RUN_HNSW_TEST=1 vitest run src/database/server.hnsw-dim.test.ts",
    "test:quality": "vitest run src/test-quality/",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:integration": "vitest run src/**/*.integration.test.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "@prisma/client": "6.19.3",
    "@prisma/instrumentation": "6.19.3",
    "bcrypt": "6.0.0",
    "bullmq": "5.79.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "7.5.1",
    "helmet": "8.2.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "rate-limit-redis": "4.3.1",
    "undici": "7.30.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "@vitest/coverage-v8": "4.1.9",
    "cross-env": "7.0.3",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "pino-pretty": "13.1.3",
    "prisma": "6.19.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "c12": {
      "magicast": "^0.5.2"
    }
  }
}
