# WARNING: Do not use these values in production — they are insecure development defaults. Create .env from this template and set real secrets.
# ───────────────────────────────────────────────────────────────────────────────
# CinematicAI Studio — Local Development Environment Example
# ───────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in values. NEVER commit .env with real credentials.
#
#   cp .env.example .env
#   docker compose up -d
#
# Then browse to http://localhost:3000, register a user, and start generating.
#
# MINIMUM REQUIRED: at least one AI API key (KIMI_API_KEY or MISTRAL_API_KEY).
# The defaults below get the stack running but story generation will fail
# without a valid AI provider key.
# ───────────────────────────────────────────────────────────────────────────────

# ─── Database ──────────────────────────────────────────────────────────────────
# Password for the postgres user. Must match the password embedded in DATABASE_URL.
POSTGRES_PASSWORD=local_dev_pg_1a2b3c4d

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Password for Redis. REQUIRED — without this, Redis accepts unauthenticated
# connections from any host that can reach port 6379.
REDIS_PASSWORD=local_dev_redis_5e6f7g8h

# ─── Connection URLs (must match passwords above) ─────────────────────────────
DATABASE_URL=postgresql://postgres:local_dev_pg_1a2b3c4d@postgres:5432/cinematicai?schema=public
REDIS_URL=redis://:local_dev_redis_5e6f7g8h@redis:6379

# ─── API auth ──────────────────────────────────────────────────────────────────
# Used as the HMAC signing key for SSE URLs.
API_SECRET=local_dev_api_secret_9a0b1c2d
# Used for /api/admin/* routes (privilege-separated from API_SECRET).
ADMIN_API_KEY=local_dev_admin_key_3e4f5g6h
# Used to sign JWTs. Distinct from API_SECRET so SSE HMAC and JWT keys can be
# rotated independently.
JWT_SECRET=local_dev_jwt_secret_7i8j9k0l


# ─── AI providers (at least ONE required) ────────────────────────────────────
# Kimi K3 — story blueprint, bibles, episodes, scenes, dialogue, SEO (OpenAI-compatible)
# Get your API key from https://platform.moonshot.cn
# KIMI_API_KEY=your_kimi_key_here
# KIMI_BASE_URL=https://api.kimi.com/coding/v1/chat/completions
# KIMI_MODEL=k3

# Mistral AI — universal fallback for ALL stages + embeddings
# Get your API key from https://console.mistral.ai
# MISTRAL_API_KEY=your_mistral_key_here
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=mistral-medium-2508

# ─── Observability ─────────────────────────────────────────────────────────────
# Set to "true" to collect default Node.js/OS metrics alongside app metrics.
# ENABLE_DEFAULT_METRICS=false

# Embedding model for vector similarity
# EMBEDDING_MODEL=mistral-embed-2312

# ─── E2E / test mode ──────────────────────────────────────────────────────────
# Set to "canned" only when running E2E tests. Bypasses real AI with deterministic
# responses. Leave empty in production.
# STORY_TEST_MODE=
# CANNED_DEBUG=false

# Set E2E_TEST=true to disable all rate limiters (auth + AI + general) for
# integration and end-to-end testing. NEVER enable in production.
# E2E_TEST=false

# ALLOW_INSECURE_LOCAL_HTTP=true opts the backend into accepting cookie/CSRF/JWT
# auth over plain HTTP. Required for local Docker Compose (which does not
# terminate TLS) because browsers withhold Secure cookies over HTTP. Docker
# Compose already sets this for the local stack; uncomment only if you are
# running the backend directly outside Docker on localhost without HTTPS.
# NEVER enable in production.
# ALLOW_INSECURE_LOCAL_HTTP=false

# Set ALLOW_DLQ_QUALITY_OVERRIDE=true to let DLQ retries bypass the configured
# qualityFloor/gradeFloor. Without this flag, DLQ retries keep the normal quality
# gates. Use sparingly and only for operational recovery.
# ALLOW_DLQ_QUALITY_OVERRIDE=false

# ─── Production Hardening (single-user / invite-only) ──────────────────────────
# Set DISABLE_REGISTRATION=true to block open signup. The first user can still
# register with INVITE_CODE; subsequent registrations are rejected.
# IMPORTANT: In production, always set this to true and use INVITE_CODE for
# initial admin setup. Leaving registration open allows anyone to register.
#
# HIGH-6: When DISABLE_REGISTRATION=false (open registration), the first user
# registered is a regular user by default — auto-elevation to admin requires
# BOOTSTRAP_FIRST_USER_ADMIN=true. This prevents an attacker from owning the
# deployment by registering first on a fresh public instance. When
# DISABLE_REGISTRATION=true (invite-only), the first user is always admin
# because they already passed the INVITE_CODE gate (operator intent).
# DISABLE_REGISTRATION=true
# INVITE_CODE=change_me_to_a_random_32_char_string
# BOOTSTRAP_FIRST_USER_ADMIN=false

# ─── AI Cost and Quota Controls ────────────────────────────────────────────────
# Hard caps on generation volume. 0 = unlimited.
# MAX_CONCURRENT_GENERATIONS=2
# MAX_STORIES_PER_DAY=10
# AI_DAILY_SPEND_CAP_USD=10
# AI_MONTHLY_SPEND_CAP_USD=100
# AI_DAILY_TOKEN_BUDGET=100000
# AI_MONTHLY_TOKEN_BUDGET=1000000

# ─── TLS / Reverse Proxy ───────────────────────────────────────────────────────
# Domain for the Caddy reverse proxy in docker-compose.prod.yml.
# CADDY_HOST=yourdomain.com

# ─── Backups ───────────────────────────────────────────────────────────────────
# Optional S3 destination for daily PostgreSQL + Redis backups.
# BACKUP_S3_BUCKET=your-backup-bucket
# BACKUP_S3_PREFIX=cinematicai-backups

# ─── Alerting ──────────────────────────────────────────────────────────────────
# Shared bearer token Prometheus/Alertmanager uses to POST alerts to the
# backend receiver at /api/alerts/alerts. Generate with: openssl rand -hex 32
# ALERT_RECEIVER_TOKEN=change_me_to_a_random_64_char_hex_string

# Optional external webhook for Prometheus alerts (Slack, PagerDuty, etc.)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─── Auth Rate Limits ─────────────────────────────────────────────────────────
# Max login/register/session operations per 15-minute window per IP.
# Raise these when running integration tests against a live backend.
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# AUTH_REGISTER_RATE_LIMIT_MAX=10
# AUTH_SESSION_RATE_LIMIT_MAX=30
